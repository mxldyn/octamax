 "changes": [
  {
   "id": "slice-playhead",
   "source": "tools/patch_sliceview.s + tools/build_sliceview.py",
   "desc": "PERSONALIZE toggle SLICE PLAYHEAD: the SRC>SLICES view shows the playing slice number in a trig-key frame, a live progress bar and the slice's loop point; the playing slice's trig button lights amber and pulses with the tempo LED. Off by default = stock view byte-for-byte."
  },
  {
   "id": "personalize-persistence",
   "source": "tools/build_sliceview.py (3 restore-length immediates) + shadow-writing setters",
   "desc": "All custom PERSONALIZE toggles persist across power cycles and OS upgrades: the battery-SRAM settings restore covers the custom words (0x64 -> 0x70) and the setters write the checksummed shadow block."
  },
  {
   "id": "static-slots-256",
   "source": "tools/build_dual256.py + tools/build_persist256.py",
   "desc": "STATIC sample slots 128 -> 256. High slots load samples, keep their slices, stay assigned to a track across a save/reload and a power cycle, accept parameter locks and play on the first trig. Persisted in project.work plus a project.256 sidecar. NEW IN 2.0."
  },
  {
   "id": "arp-key-scales",
   "source": "tools/patch_arp.s",
   "desc": "10 extra arpeggiator key-scale qualities beyond major/minor (the five Greek modes, blues, phrygian-dominant, melodic-minor, octatonic, hirajoshi). OFF/maj/min stay byte-identical to stock."
  },
  {
   "id": "lazy-transitions",
   "source": "tools/patch.s + patch_enc.s + patch_led.s + patch_scene2.s",
   "desc": "On a pattern change to a different Part, sounding tracks keep the previous Part's sound (track LED dimmed) until a trig or an encoder move; A/B scene pointers stay on the same slots. Off by default."
  },
  {
   "id": "no-bank-ptn-countdown",
   "source": "tools/patch_notimer.s",
   "desc": "SELECT BANK / SELECT PATTERN windows stop expiring. Off by default."
  },
  {
   "id": "personalize-options",
   "source": "tools/patch_notimer.s",
   "desc": "The two behaviour switches are PERSONALIZE entries, unchecked by default, so an unconfigured unit behaves exactly like stock."
  },
  {
   "id": "boot-branding",
   "source": "ELEK header (-V)",
   "desc": "Boot splash and SYSTEM STATUS show OCTAMAX_2 instead of 1.40C."
  }
 ],
